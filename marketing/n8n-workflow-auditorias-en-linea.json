      "id": "11dc9f9e74af47e3",
      "name": "Leer calendario (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Selecciona el post de HOY y arma el mensaje final.\nconst rows = $input.all();\nconst t = new Date();\nconst dd = String(t.getDate()).padStart(2, '0');\nconst mm = String(t.getMonth() + 1).padStart(2, '0');\nconst yyyy = t.getFullYear();\nconst hoy = `${dd}/${mm}/${yyyy}`;\n\nconst match = rows.find(r =>\n  String(r.json.Fecha).trim() === hoy &&\n  String(r.json.Estado || '').toLowerCase() !== 'publicado'\n);\n\nif (!match) { return []; }  // no hay nada para publicar hoy\n\nconst j = match.json;\nconst mensaje = `${j.Copy}\\n\\n${j.Hashtags}\\n\\n${j.CTA}`;\n\nreturn [{\n  json: {\n    ...j,\n    mensaje,\n    hoy,\n    rowNumber: match.json.row_number,\n  }\n}];\n"
      },
      "id": "0cd4611becc44514",
      "name": "Elegir post de hoy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "304b4cd90309440e",
              "leftValue": "={{ $json.mensaje }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "43e79dbed5a04851",
      "name": "¿Hay post para hoy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
