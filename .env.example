# Base
# Public URL of the app (served by nginx on port 80/443).
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=super_secret_nextauth_key_12345
# Leave empty: the browser calls the API through nginx using relative URLs
# (/api/...). The backend is NOT published to the host, only nginx is.
API_URL=
JWT_SECRET=super_secret_jwt_key_12345678901234567890

# Database
DB_USER=aeonline
DB_PASSWORD=aeonline_secret
DB_NAME=aeonline_db

# Redis
REDIS_PASSWORD=redis_secret

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_admin

# Email (2FA + notificaciones)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=fake_resend_key
FROM_EMAIL=noreply@auditoriasenlinea.com.ar

# Notificaciones transaccionales del sistema (alta de tenant, invitaciones,
# auditorías, calibraciones, mantenimiento, vencimientos). Todas salen desde
# esta casilla. Verificá el dominio/casilla en tu proveedor SMTP.
NOTIFICATIONS_FROM_EMAIL=notificaciones@auditoriasenlinea.com.ar
NOTIFICATIONS_ENABLED=true
# URL pública usada en los botones/enlaces de los correos.
APP_BASE_URL=https://sgna.auditoriasenlinea.com.ar

# Barrido preventivo ("por vencer"): anticipación en días de cada aviso.
NOTIF_CALIBRACION_DIAS=15
NOTIF_MANTENIMIENTO_DIAS=7
NOTIF_APROBACION_DIAS=3

# Scheduler interno que corre el barrido a diario (APScheduler).
SCHEDULER_ENABLED=true
NOTIF_HORA_UTC=10
# Secreto para disparar el barrido desde un cron externo / n8n
# (POST /api/v1/cron/notificaciones con header X-Cron-Secret).
# Si queda vacío, ese endpoint queda deshabilitado y solo corre el scheduler interno.
CRON_SECRET=

# --- Transcripción de notas de voz (Auditor en Campo) ---------------------
# El auditor puede dictar la observación de un punto de control en vez de
# escribirla. El audio SIEMPRE se guarda como evidencia en el bucket del tenant;
# la conversión a texto se ejecuta al firmar la auditoría.
# Proveedores: "openai" (activo) | "none" (deshabilitado, el audio queda igual adjunto).
TRANSCRIPTION_PROVIDER=openai
# OBLIGATORIA para que funcione: clave de OpenAI (sk-...). Si se deja vacía, la
# transcripción queda inactiva y las notas de voz solo se guardan como evidencia.
# Alternativamente se puede usar el nombre estándar OPENAI_API_KEY.
TRANSCRIPTION_API_KEY=
# Modelos válidos: whisper-1 (por defecto), gpt-4o-transcribe, gpt-4o-mini-transcribe.
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_LANGUAGE=es
TRANSCRIPTION_MAX_MB=25

# Agendamiento de demos (landing → botón WhatsApp/bot)
# Email del equipo comercial que recibe los avisos de demo.
SALES_EMAIL=ventas@auditoriasenlinea.com.ar
DEMO_TIMEZONE=America/Argentina/Mendoza

# Google Calendar (opcional): agenda automática con Google Meet.
# Requiere una cuenta de servicio de Google Cloud con la Calendar API habilitada
# y DELEGACIÓN DE DOMINIO autorizada en Google Workspace para el scope
# https://www.googleapis.com/auth/calendar.events
# - GOOGLE_SERVICE_ACCOUNT_JSON: contenido JSON de la clave de la cuenta de servicio (en una línea).
# - GOOGLE_CALENDAR_ORGANIZER: usuario de Workspace a impersonar (dueño del evento), ej: ventas@auditoriasenlinea.com.ar
# - GOOGLE_CALENDAR_ID: normalmente "primary".
# Si se dejan vacías, el sistema igual envía el aviso por email y ofrece los enlaces directos.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ORGANIZER=
GOOGLE_CALENDAR_ID=primary

# WhatsApp Cloud API (opcional): aviso automático al equipo comercial.
# Desde Meta for Developers → WhatsApp → API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_TO=5492615708516

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# IA / MCP
ANTHROPIC_API_KEY=your_anthropic_api_key
