# Base
# Public URL of the app (served by nginx on port 80/443).
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=super_secret_nextauth_key_12345
# Leave empty: the browser calls the API through nginx using relative URLs
# (/api/...). The backend is NOT published to the host, only nginx is.
API_URL=
JWT_SECRET=super_secret_jwt_key_12345678901234567890

# Database
DB_USER=aeonline
DB_PASSWORD=aeonline_secret
DB_NAME=aeonline_db

# Redis
REDIS_PASSWORD=redis_secret

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_admin

# Email (2FA + notificaciones)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=fake_resend_key
FROM_EMAIL=noreply@auditoriasenlinea.com.ar

# Agendamiento de demos (landing → botón WhatsApp/bot)
# Email del equipo comercial que recibe los avisos de demo.
SALES_EMAIL=ventas@auditoriasenlinea.com.ar
DEMO_TIMEZONE=America/Argentina/Mendoza

# Google Calendar (opcional): agenda automática con Google Meet.
# Requiere una cuenta de servicio de Google Cloud con la Calendar API habilitada
# y DELEGACIÓN DE DOMINIO autorizada en Google Workspace para el scope
# https://www.googleapis.com/auth/calendar.events
# - GOOGLE_SERVICE_ACCOUNT_JSON: contenido JSON de la clave de la cuenta de servicio (en una línea).
# - GOOGLE_CALENDAR_ORGANIZER: usuario de Workspace a impersonar (dueño del evento), ej: ventas@auditoriasenlinea.com.ar
# - GOOGLE_CALENDAR_ID: normalmente "primary".
# Si se dejan vacías, el sistema igual envía el aviso por email y ofrece los enlaces directos.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ORGANIZER=
GOOGLE_CALENDAR_ID=primary

# WhatsApp Cloud API (opcional): aviso automático al equipo comercial.
# Desde Meta for Developers → WhatsApp → API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_TO=5492615708516

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# IA / MCP
ANTHROPIC_API_KEY=your_anthropic_api_key
